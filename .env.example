# LLM
ANTHROPIC_API_KEY=

# Optional thin OpenAI fallback (Week 2+)
OPENAI_API_KEY=

# LangSmith — required for local LangGraph Studio / `langgraph dev` tracing
# Create a key at https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=underwriting-agent

# Legacy aliases (still honored by LangChain; prefer LANGSMITH_* above)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=underwriting-agent

# Postgres + pgvector (docker compose service `postgres`)
#   docker compose up -d postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=54326
POSTGRES_USER=underwriting
POSTGRES_PASSWORD=underwriting
POSTGRES_DB=underwriting_db
# RagPipeline / langchain-postgres require the psycopg driver scheme:
DATABASE_URL=postgresql+psycopg://underwriting:underwriting@localhost:54326/underwriting_db

# RAG ingest / retrieval (defaults: pgvector only — Elasticsearch not used yet)
RAG_INDEX_NAME=underwriting_policy_chunk_512
RAG_INGEST_TARGETS=vector
RAG_STRATEGY=vector
RAG_ALLOW_HYBRID=false
RAG_CHUNK_SIZE=512
RAG_TOP_K=5

# Voyage embeddings (required for rag ingest / retrieve)
VOYAGE_API_KEY=

# Admin HTTP API (`uv run underwriting-api`)
# When set, /admin/* requires header X-Admin-Key
ADMIN_API_KEY=
API_HOST=127.0.0.1
API_PORT=8080
API_RELOAD=true
# Browser origins for the Next.js console (`web/`)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional hybrid / rerank backends (unused while RAG_ALLOW_HYBRID=false)
# ELASTICSEARCH_URL=http://localhost:9200
# COHERE_API_KEY=

# Hard-coded risk ceiling — never override via prompt
# Applicants at or above this risk score always escalate
RISK_CEILING=0.75
