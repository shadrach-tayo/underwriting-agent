# LLM
ANTHROPIC_API_KEY=

# Optional thin OpenAI fallback (Week 2+)
OPENAI_API_KEY=

# LangSmith tracing (enable from first LangGraph run)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=underwriting-agent

# Postgres + pgvector (Week 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/underwriting

# Hard-coded risk ceiling — never override via prompt
# Applicants at or above this risk score always escalate
RISK_CEILING=0.75
