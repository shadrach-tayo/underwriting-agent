NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# Leave empty unless this UI is only on your machine. The value is shipped to the browser.
# When set, it must match ADMIN_API_KEY on the Python API.
NEXT_PUBLIC_ADMIN_API_KEY=
# Show Admin in the header and enable /admin. Off unless 1/true/yes.
NEXT_PUBLIC_SHOW_ADMIN=
